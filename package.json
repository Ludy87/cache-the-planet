{
  "name": "github-actions-content-cache",
  "private": true,
  "version": "1.1.0",
  "description": "Content-addressed GitHub Actions cache",
  "author": "Ludy87",
  "keywords": [
    "github-actions",
    "github-action",
    "cache",
    "content-addressed-storage",
    "build-cache",
    "artifact-cache",
    "npm",
    "gradle",
    "maven",
    "uv",
    "docker"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "build": "esbuild ./src/restore.js --bundle --platform=node --target=node24 --minify --outfile=./dist/restore.js && esbuild ./src/save.js --bundle --platform=node --target=node24 --minify --outfile=./dist/save.js && esbuild ./src/gc.js --bundle --platform=node --target=node24 --minify --outfile=./dist/gc.js && esbuild ./src/pr-cleanup.js --bundle --platform=node --target=node24 --minify --outfile=./dist/pr-cleanup.js && esbuild ./src/common.js --platform=node --target=node24 --minify --outfile=./dist/common.js",
    "build:check": "npm run build && git diff --exit-code -- dist",
    "test": "node --check src/common.js && node --check src/restore.js && node --check src/save.js && node --check src/gc.js && node --check src/pr-cleanup.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@actions/github": "^9.1.1"
  }
}
