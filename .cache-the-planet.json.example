{
  "cache_repository": "owner/cache-repository",
  "manifest_branch": "cache-data",
  "monitoring": {
    "max_manifest_references": 100000,
    "max_manifest_writes_per_hour": 1000
  },
  "security": {
    "max_compressed_bytes": 2147483648,
    "max_tar_bytes": 8589934592,
    "max_entries": 200000,
    "max_logical_key_length": 512,
    "max_logical_key_components": 16,
    "allowed_cache_names": [
      "npm",
      "uv",
      "uv-python-3-13",
      "maven-java17",
      "gradle-java17",
      "docker",
      "task"
    ]
  }
}
